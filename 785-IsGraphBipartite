5            if odd[i]:
6                return True
7            q=deque([i])
8            odd[i]=-1
9            while q:
10                i=q.popleft()
11                for nei in graph[i]:
12                    if odd[i]==odd[nei]:
13                        return False
14                    elif not odd[nei]:
15                        q.append(nei)
16                        odd[nei]=-1*odd[i]
17            return True
18        
